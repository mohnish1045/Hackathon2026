generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ItemType {
  ASSIGNMENT
  EXAM
  EVENT
  DEADLINE
  TASK
  MEETING
  STUDY_BLOCK
}
enum ItemSource {
  CANVAS
  GOOGLE_CALENDAR
  WEB
  MANUAL
  AI
}
enum Priority {
  LOW
  MEDIUM
  HIGH
}
enum ConnectionType {
  CANVAS
  GOOGLE_CALENDAR
  WEB
}
enum ConnectionStatus {
  CONNECTED
  ERROR
  PENDING
  DISCONNECTED
}
enum SuggestionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model User {
  id String @id @default(cuid())
  name String?
  email String? @unique
  image String?
  accounts Account[]
  sessions Session[]
  sourceConnections SourceConnection[]
  webSources WebSource[]
  plannerItems PlannerItem[]
  tasks Task[]
  conversations AIConversation[]
  suggestedSchedules SuggestedSchedule[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id String @id @default(cuid())
  userId String
  type String
  provider String
  providerAccountId String
  refresh_token String? @db.Text
  access_token String? @db.Text
  expires_at Int?
  token_type String?
  scope String?
  id_token String? @db.Text
  session_state String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id String @id @default(cuid())
  sessionToken String @unique
  userId String
  expires DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token String @unique
  expires DateTime
  @@unique([identifier, token])
}

model SourceConnection {
  id String @id @default(cuid())
  userId String
  type ConnectionType
  status ConnectionStatus @default(PENDING)
  displayName String
  config Json?
  lastSyncedAt DateTime?
  lastError String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  items PlannerItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([userId, type])
}

model WebSource {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  url String
  title String?
  extractedText String? @db.Text
  confidence Float?
  approvedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items PlannerItem[]
}

model PlannerItem {
  id String @id @default(cuid())
  userId String
  sourceConnectionId String?
  webSourceId String?
  source ItemSource
  sourceId String?
  title String
  description String? @db.Text
  type ItemType
  course String?
  startAt DateTime?
  endAt DateTime?
  dueAt DateTime?
  location String?
  url String?
  priority Priority @default(MEDIUM)
  estimatedMinutes Int?
  completed Boolean @default(false)
  isFixed Boolean @default(false)
  metadata Json?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceConnection SourceConnection? @relation(fields: [sourceConnectionId], references: [id], onDelete: SetNull)
  webSource WebSource? @relation(fields: [webSourceId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([userId, source, sourceId])
  @@index([userId, startAt])
  @@index([userId, dueAt])
  @@index([userId, source])
}

model Task {
  id String @id @default(cuid())
  userId String
  title String
  description String?
  dueAt DateTime?
  estimatedMinutes Int @default(60)
  priority Priority @default(MEDIUM)
  completed Boolean @default(false)
  plannerItemId String? @unique
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId, dueAt])
}

model AIConversation {
  id String @id @default(cuid())
  userId String
  title String @default("New planning chat")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AIMessage[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AIMessage {
  id String @id @default(cuid())
  conversationId String
  role String
  content String @db.Text
  metadata Json?
  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model SuggestedSchedule {
  id String @id @default(cuid())
  userId String
  title String
  startAt DateTime
  endAt DateTime
  reason String
  relatedItemId String?
  status SuggestionStatus @default(PENDING)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId, status])
}
